{
  "name": "@leonorevault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next-handler": {
      "types": "./dist/next-handler.d.ts",
      "import": "./dist/next-handler.js"
    },
    "./auth": {
      "types": "./dist/config/better-auth.d.ts",
      "import": "./dist/config/better-auth.js"
    },
    "./database": {
      "types": "./dist/db/client.d.ts",
      "import": "./dist/db/client.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:backup": "tsx --env-file=../../.env scripts/migrate-postgres-backup-to-turso.ts",
    "db:migrate:auth": "tsx --env-file=../../.env scripts/migrate-auth-accounts-to-better-auth.ts",
    "db:migrate:history": "tsx --env-file=../../.env scripts/migrate-borrowing-and-session-history.ts",
    "db:migrate:attachments:r2": "tsx --env-file=../../.env scripts/migrate-legacy-attachments-to-r2.ts",
    "db:validate:migration": "tsx --env-file=../../.env scripts/validate-migration.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "@better-auth/drizzle-adapter": "1.6.29",
    "@leonorevault/shared": "workspace:*",
    "@libsql/client": "0.17.4",
    "better-auth": "1.6.29",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jspdf": "^4.1.0",
    "multer": "^2.0.2",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
